# Supabase Database Connection
# You can find this in Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
# Note: Since JDBC uses 'jdbc:postgresql://', make sure to format it correctly.
SUPABASE_DB_URL=jdbc:postgresql://db.xxxxxx.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password

# Supabase JWT Secret
# You can find this in Supabase Dashboard -> Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Spring Profiles
SPRING_PROFILES_ACTIVE=local
