# ==========================================
# Exemplo de variáveis de ambiente para backend-java
# Copie este arquivo para .env localmente caso utilize uma ferramenta
# de carregamento (ou defina no seu shell/IDE antes de executar)
# ==========================================

# 1. Chave da API do Google Gemini (obrigatória para o funcionamento do ChatController)
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_do_aistudio_aqui

# 2. ID do projeto Firebase (utilizado pelo Firebase Admin SDK)
FIREBASE_PROJECT_ID=rotinai-seu-projeto

# 3. Caminho local para o JSON de credenciais (Service Account) do Firebase
# Opcional se estiver rodando no Google Cloud (Cloud Run) com IAM habilitado.
# Localmente: baixe o json no Firebase Console e aponte o caminho abaixo.
GOOGLE_APPLICATION_CREDENTIALS=/caminho/absoluto/para/serviceAccountKey.json

# 4. Domínios permitidos pelo CORS (separados por vírgula)
# Em dev: http://localhost:5173,http://localhost:3000
# Em produção: inclua o domínio real do app Diurno
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 5. Porta HTTP de execução (Cloud Run injeta 8080 automaticamente)
PORT=8080
