rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; } 
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // User validation
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.email is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users cannot list other users
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().createdAt == existing().createdAt
                    && incoming().email == existing().email
                    && incoming().updatedAt == request.time;
      allow delete: if isOwner(userId);
    }

    // Task validation
    function isValidTask(data) {
      return data.keys().hasAll(['userId', 'completed', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.completed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /tasks/{taskId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && isValidId(taskId)
                    && isValidTask(incoming())
                    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
                    && isValidId(taskId)
                    && existing().userId == request.auth.uid
                    && isValidTask(incoming())
                    && incoming().userId == existing().userId
                    && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Habit validation (if needed separately, otherwise covered by tasks)
    function isValidHabit(data) {
      return data.keys().hasAll(['userId', 'title', 'currentStreak', 'maxStreak', 'totalCompletions', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.title is string
        && data.currentStreak is number && data.currentStreak >= 0
        && data.maxStreak is number && data.maxStreak >= 0
        && data.totalCompletions is number && data.totalCompletions >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /habits/{habitId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && isValidId(habitId)
                    && isValidHabit(incoming())
                    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
                    && isValidId(habitId)
                    && existing().userId == request.auth.uid
                    && isValidHabit(incoming())
                    && incoming().userId == existing().userId
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
