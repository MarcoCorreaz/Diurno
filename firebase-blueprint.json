{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing onboarding preferences",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "goal": { "type": "string", "maxLength": 100 },
        "energy": { "type": "string", "maxLength": 100 },
        "routineDetails": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["name", "email", "createdAt", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "A routine task for a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "completed": { "type": "boolean" },
        "time": { "type": "string", "maxLength": 20 },
        "category": { "type": "string", "maxLength": 100 },
        "dayOfWeek": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["userId", "title", "completed", "createdAt", "updatedAt"]
    },
    "Habit": {
      "title": "Habit",
      "description": "A trackable habit for a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "time": { "type": "string", "maxLength": 20 },
        "currentStreak": { "type": "number" },
        "maxStreak": { "type": "number" },
        "totalCompletions": { "type": "number" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["userId", "title", "currentStreak", "maxStreak", "totalCompletions", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile documents"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "User tasks collection"
    },
    "/habits/{habitId}": {
      "schema": { "$ref": "#/entities/Habit" },
      "description": "User habits collection"
    }
  }
}
