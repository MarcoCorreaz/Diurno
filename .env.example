# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:5173"

# Supabase Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Stripe Configuration (SaaS Billing)
VITE_STRIPE_PUBLIC_KEY="sua_chave_publica_aqui"
STRIPE_SECRET_KEY="sua_chave_secreta_aqui"
STRIPE_WEBHOOK_SECRET="seu_webhook_secret_aqui"

# IDs dos Preços (Products) criados no painel do Stripe
STRIPE_PRICE_PRO_MONTHLY="price_XXXXXXXXXXXXXXX"
STRIPE_PRICE_PRO_YEARLY="price_XXXXXXXXXXXXXXX"
STRIPE_PRICE_LIFETIME="price_XXXXXXXXXXXXXXX"
