# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only, Vercel Functions).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (used for CORS in /api/chat).
APP_URL="http://localhost:5173"

# Supabase Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Service role key — NEVER expose to the browser. Server-side only.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Stripe / Asaas (Payments)
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"
ASAAS_API_KEY="your-asaas-api-key"
ASAAS_WEBHOOK_SECRET="your-asaas-webhook-secret"

# E-mail Transacional (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxx"
SEND_EMAIL_HOOK_SECRET="xxxx"
FROM_EMAIL="Rituno <noreply@rituno.com.br>"

# Observabilidade (Sentry)
VITE_SENTRY_DSN="https://xxxxx@sentry.io/xxxxx"

# Rituno URLs e Emails
VITE_SUPPORT_EMAIL="suporte@rituno.com.br"
VITE_PRIVACY_EMAIL="privacidade@rituno.com.br"
