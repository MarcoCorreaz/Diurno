# Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL pública da aplicação
APP_URL="http://localhost:5173"

# Supabase
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Asaas Billing
# Sandbox: https://api-sandbox.asaas.com/v3
# Produção: https://api.asaas.com/v3
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY="$aact_hmlg_..."

# Token de autenticação configurado no Webhook Asaas.
# Deve ter entre 32 e 255 caracteres e não pode ser a API key.
ASAAS_WEBHOOK_TOKEN="gere-um-token-longo-e-aleatorio-com-32-caracteres-ou-mais"

# Opcional. O código infere automaticamente a URL pelo ambiente.
# ASAAS_CHECKOUT_URL="https://sandbox.asaas.com/checkoutSession/show"
